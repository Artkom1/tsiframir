[Unit]
Description=TsifraMir seminar paid order WhatsApp report
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=3

[Service]
Type=oneshot
User=tsiframir-site
Group=tsiframir-site
EnvironmentFile=/etc/tsiframir-site/paid-report.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 /opt/tsiframir-site/reports/current/scripts/seminar_paid_report.py --mode daily
StateDirectory=tsiframir-paid-report
StateDirectoryMode=0700
UMask=0077
TimeoutStartSec=300
Restart=on-failure
RestartSec=60
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
